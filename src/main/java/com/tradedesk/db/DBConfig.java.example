package com.tradedesk.db;

/**
 * Database settings. Reads environment variables, falls back to local defaults.
 * This file is in .gitignore - do NOT commit real credentials.
 * Owner: Member 2
 */
public final class DBConfig {

    public static final String URL = env("TRADEDESK_DB_URL",
            "jdbc:mysql://localhost:3306/tradedesk?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC");
    public static final String USER     = env("TRADEDESK_DB_USER", "root");
    public static final String PASSWORD = env("TRADEDESK_DB_PASSWORD", "");
    public static final int    POOL_SIZE = 5;

    /** Starting cash for every new user (matches leaderboard scores, ~1,000,000). */
    public static final double STARTING_CASH = 1_000_000.00;

    private DBConfig() {}

    private static String env(String key, String fallback) {
        String v = System.getenv(key);
        return (v == null || v.isBlank()) ? fallback : v;
    }
}
